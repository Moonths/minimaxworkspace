# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Execution ──────────────────────────────────────────────────
EXECUTOR_MODE=mock        # mock | comfyui
COMFYUI_BASE_URL=         # Example: http://100.x.x.x:8188 (local .env only)
COMFYUI_TIMEOUT_MS=10000  # Remote request timeout
